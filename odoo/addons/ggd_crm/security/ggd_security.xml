<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Outreach approver.

        Approving outreach and clearing "Do not contact" are the two writes
        that authorise an email to a real person. Until this group existed,
        any identity with write access to crm.lead could perform both,
        including the API-key user n8n runs as. "The LLM never approves" was
        a property of the workflow JSON, not of Odoo authorisation. The addon
        now refuses both writes unless the acting user is in this group (the
        superuser is exempt, as it is from every Odoo access rule).

        Membership is data: the administrator is added here so an upgrade
        does not lock the owner out. The n8n service user must NOT be added.
    -->
    <record id="res_groups_privilege_ggd" model="res.groups.privilege">
        <field name="name">Germany Growth Desk</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_ggd_outreach_approver" model="res.groups">
        <field name="name">Outreach approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ggd"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">May approve outreach for a lead and may clear the Do not contact flag. The n8n service user must never be in this group.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!--
        Guarded-action log.

        Every internal user may read and append; nobody may edit or delete a
        row through the ORM, including the administrator. The log is what
        makes a retried action idempotent and what proves a manual contact
        happened before an opportunity moved to Contacted, and both
        guarantees are worth exactly as much as the rows are hard to rewrite.
        The superuser is exempt from access rules as always, which is the
        escape hatch for a genuine repair done deliberately from the shell.
    -->
    <record id="access_ggd_opportunity_action_log_user" model="ir.model.access">
        <field name="name">ggd.opportunity.action.log: read and append</field>
        <field name="model_id" ref="model_ggd_opportunity_action_log"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!--
        Product groups (issue #67).

        Every internal user reads them, because a group that cannot be read
        cannot be filtered on and the pipeline selector would be empty for
        everybody but an administrator. Only a Sales Administrator adds or
        renames one: the list is a shared vocabulary, and a vocabulary each
        salesperson can extend at will stops being one.

        Nobody deletes one, including the administrator. Archiving is the
        supported retirement, and it is deliberately not the same thing:
        archiving hides the group from the pickers and leaves every historical
        link in place, while a delete would take the m2m rows with it and
        quietly rewrite what a lead was once classified as. A genuine repair
        is still possible from the shell as the superuser, deliberately.
    -->
    <record id="access_ggd_product_group_user" model="ir.model.access">
        <field name="name">ggd.product.group: read</field>
        <field name="model_id" ref="model_ggd_product_group"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_ggd_product_group_manager" model="ir.model.access">
        <field name="name">ggd.product.group: add, rename and archive</field>
        <field name="model_id" ref="model_ggd_product_group"/>
        <field name="group_id" ref="sales_team.group_sale_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!--
        The three bulk actions.

        These are transient records that hold a selection and a set of
        options; they enforce nothing themselves. Every rule that matters -
        who may write which opportunity, which stage may be reached, what
        Do not contact stops - is checked against crm.lead when Apply runs,
        so giving a salesperson full rights on the wizard grants no power
        they did not already have on the records they own.
    -->
    <record id="access_ggd_lead_group_wizard" model="ir.model.access">
        <field name="name">ggd.lead.group.wizard: salesperson</field>
        <field name="model_id" ref="model_ggd_lead_group_wizard"/>
        <field name="group_id" ref="sales_team.group_sale_salesman"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="access_ggd_lead_stage_wizard" model="ir.model.access">
        <field name="name">ggd.lead.stage.wizard: salesperson</field>
        <field name="model_id" ref="model_ggd_lead_stage_wizard"/>
        <field name="group_id" ref="sales_team.group_sale_salesman"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="access_ggd_lead_followup_wizard" model="ir.model.access">
        <field name="name">ggd.lead.followup.wizard: salesperson</field>
        <field name="model_id" ref="model_ggd_lead_followup_wizard"/>
        <field name="group_id" ref="sales_team.group_sale_salesman"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
