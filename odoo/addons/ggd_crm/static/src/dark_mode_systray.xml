<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ggd_crm.DarkModeToggle">
        <div class="o_ggd_dark_toggle d-flex align-items-center">
            <button type="button"
                    class="btn btn-link o-no-caret d-flex align-items-center px-2"
                    t-att-title="label"
                    t-att-aria-label="label"
                    t-on-click="() => this.onClick()">
                <i t-att-class="state.dark ? 'fa fa-sun-o' : 'fa fa-moon-o'"
                   role="img"/>
            </button>
        </div>
    </t>

</templates>
