<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Markup copied from Odoo's own systray items (mail.ActivityMenu): a
         bare button holding an fa-lg icon, inside o_menu_systray_item. The
         first version carried btn/btn-link/px-2, which made it sit and hover
         differently from the clock and chat icons beside it. -->
    <t t-name="ggd_crm.DarkModeToggle">
        <div class="o_menu_systray_item o_ggd_dark_toggle">
            <button t-att-title="label"
                    t-att-aria-label="label"
                    t-on-click="() => this.onClick()">
                <i t-att-class="'fa fa-lg ' + (state.dark ? 'fa-sun-o' : 'fa-moon-o')"
                   role="img"/>
            </button>
        </div>
    </t>

</templates>
