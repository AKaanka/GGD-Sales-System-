<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_ggd" model="ir.ui.view">
        <field name="name">crm.lead.form.ggd.controls</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_ggd_approve_outreach"
                    type="object"
                    string="Approve Outreach"
                    class="oe_highlight"
                    invisible="ggd_outreach_approved or ggd_do_not_contact"
                    groups="ggd_crm.group_ggd_outreach_approver"
                />
                <button
                    name="action_ggd_revoke_outreach"
                    type="object"
                    string="Revoke Approval"
                    invisible="not ggd_outreach_approved"
                />
                <button
                    name="action_ggd_release_failed_send_claim"
                    type="object"
                    string="Release Failed Claim"
                    confirm="Use this only after checking Zoho Sent and confirming that no email was sent. Release this failed claim?"
                    invisible="ggd_delivery_status != 'claimed'"
                />
                <button
                    name="action_ggd_resolve_automation_review"
                    type="object"
                    string="Resolve Automation Review"
                    confirm="Confirm that the qualification, reply, delivery, and workflow review items on this opportunity have been checked and resolved?"
                    invisible="not ggd_automation_needs_review"
                />
            </xpath>


            <!-- The status strip from the Aurora design: fit score ring, the
                 gate at a glance, and the send key. Sits above the title so a
                 reviewer sees where the record stands before reading it. -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="ggd_strip">
                    <field name="ggd_fit_score" widget="ggd_ring" readonly="1"/>
                    <div class="ggd_strip_main">
                        <div class="ggd_strip_pills">
                            <field name="ggd_draft_status" widget="badge" readonly="1"
                                   decoration-success="ggd_draft_status in ('approved', 'sent')"
                                   decoration-warning="ggd_draft_status == 'ready'"
                                   decoration-muted="ggd_draft_status == 'empty'"/>
                            <field name="ggd_delivery_status" widget="badge" readonly="1"
                                   invisible="not ggd_delivery_status or ggd_delivery_status == 'none'"
                                   decoration-danger="ggd_delivery_status in ('claimed', 'bounced')"
                                   decoration-success="ggd_delivery_status == 'accepted'"/>
                            <field name="ggd_reply_category" widget="badge" readonly="1"
                                   invisible="not ggd_reply_category"
                                   decoration-success="ggd_reply_category in ('interested', 'meeting')"
                                   decoration-info="ggd_reply_category in ('objection', 'unclear', 'information', 'referral')"
                                   decoration-danger="ggd_reply_category in ('unsubscribe', 'not_interested')"/>
                            <field name="ggd_qualification_state" widget="badge" readonly="1"
                                   invisible="ggd_qualification_state != 'review'"
                                   decoration-info="ggd_qualification_state == 'review'"/>
                            <field name="ggd_contact_basis" widget="badge" readonly="1"
                                   invisible="not ggd_contact_basis"/>
                            <span class="badge ggd_pill_stop" invisible="not ggd_do_not_contact">Do not contact</span>
                        </div>
                        <div class="ggd_strip_meta">
                            <span invisible="not ggd_outreach_approved">Approved by
                                <field name="ggd_outreach_approved_by" readonly="1"/> on
                                <field name="ggd_outreach_approved_at" readonly="1"/>
                            </span>
                            <span invisible="ggd_outreach_approved">Not yet approved for outreach</span>
                        </div>
                    </div>
                    <div class="ggd_strip_key">
                        <span class="ggd_label">Send key</span>
                        <field name="ggd_last_send_key" readonly="1" class="ggd_mono"/>
                        <span class="ggd_faint" invisible="ggd_delivery_status != 'claimed'">claim open</span>
                        <span class="ggd_faint" invisible="ggd_delivery_status == 'claimed'">no claim open</span>
                    </div>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="GGD Intelligence" name="ggd_intelligence">
                    <!-- How this record is filed, and nothing else. The
                         product-focus paragraph below is the description a
                         researcher wrote and is never rewritten from these;
                         these are the shelves it is filed on. Country is
                         shown read-only because it is the CRM's own field,
                         edited in the address block above - there is one
                         country on an opportunity and this is it. -->
                    <group string="Working classification" col="2">
                        <group>
                            <!-- The domain limits what may be added; it does
                                 not limit what is shown, so an archived group
                                 a record already carries stays visible. -->
                            <field name="ggd_product_group_ids"
                                   widget="many2many_tags"
                                   domain="[('active', '=', True)]"
                                   options="{'color_field': 'color', 'no_create': True}"/>
                            <field name="ggd_product_group_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="ggd_company_type"/>
                            <field name="country_id" string="Country (from the address)"
                                   readonly="1" options="{'no_open': True}"/>
                        </group>
                    </group>

                    <group string="Qualification" col="2">
                        <group>
                            <field name="ggd_industry"/>
                            <field name="ggd_source_url" widget="url"/>
                            <field name="ggd_fit_score"/>
                            <field name="ggd_qualification_state"/>
                        </group>
                        <group>
                            <field name="ggd_product_focus"/>
                            <field name="ggd_fit_summary"/>
                            <field name="ggd_personalization_angle"/>
                            <field name="ggd_recommended_buyer_roles"/>
                        </group>
                    </group>

                    <group string="Contact provenance" col="2">
                        <group>
                            <field name="ggd_contact_profile_url" widget="url"/>
                            <field name="ggd_contact_researched_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="ggd_contact_source_urls" readonly="1"/>
                            <field name="ggd_contact_confidence" readonly="1"/>
                        </group>
                    </group>

                    <group string="Reviewed outreach draft" col="2">
                        <group>
                            <field name="ggd_draft_subject"/>
                            <field name="ggd_draft_body"/>
                        </group>
                        <group>
                            <field name="ggd_draft_status" readonly="1"/>
                            <field name="ggd_draft_version" readonly="1"/>
                            <field name="ggd_draft_language" readonly="1"/>
                            <field name="ggd_approved_draft_version" readonly="1"/>
                            <field name="ggd_approved_recipient" readonly="1"/>
                        </group>
                    </group>

                    <group string="Outreach control" col="2">
                        <group>
                            <field name="ggd_contact_basis"/>
                            <field name="ggd_contact_basis_note"/>
                            <field name="ggd_do_not_contact"/>
                        </group>
                        <group>
                            <field name="ggd_outreach_approved" readonly="1"/>
                            <field name="ggd_outreach_approved_by" readonly="1"/>
                            <field name="ggd_outreach_approved_at" readonly="1"/>
                            <field name="ggd_contact_basis_verified_at" readonly="1"/>
                        </group>
                    </group>

                    <group string="Reply analysis" col="2">
                        <group>
                            <field name="ggd_reply_category"/>
                            <field name="ggd_reply_summary"/>
                            <field name="ggd_suggested_next_action"/>
                        </group>
                        <group>
                            <field name="ggd_ai_confidence"/>
                            <field name="ggd_ai_last_analyzed_at" readonly="1"/>
                            <field name="ggd_last_message_id" readonly="1"/>
                            <field name="ggd_last_send_key" readonly="1"/>
                            <field name="ggd_last_confirmed_send_key" readonly="1"/>
                            <field name="ggd_last_sent_at" readonly="1"/>
                            <field name="ggd_claimed_recipient" readonly="1"/>
                            <field name="ggd_claimed_draft_version" readonly="1"/>
                            <field name="ggd_send_confirmed_at" readonly="1"/>
                            <field name="ggd_last_claim_released_at" readonly="1"/>
                            <field name="ggd_last_claim_released_by" readonly="1"/>
                            <field name="ggd_delivery_status" readonly="1"/>
                            <field name="ggd_last_message_date" readonly="1"/>
                            <field name="ggd_last_reply_received_at" readonly="1"/>
                            <field name="ggd_last_reply_message_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Automation review and follow-up" col="2">
                        <group>
                            <field name="ggd_response_draft"/>
                            <field name="ggd_suggested_follow_up_at"/>
                            <field name="ggd_follow_up_draft"/>
                        </group>
                        <group>
                            <field name="ggd_automation_needs_review" readonly="1"/>
                            <field name="ggd_automation_review_summary"/>
                            <field name="ggd_qualification_needs_review" readonly="1"/>
                            <field name="ggd_reply_needs_review" readonly="1"/>
                            <field name="ggd_delivery_needs_review" readonly="1"/>
                            <field name="ggd_workflow_needs_review" readonly="1"/>
                            <field name="ggd_last_follow_up_queued_at" readonly="1"/>
                        </group>
                    </group>

                    <group string="Last confirmed outbound audit" col="2">
                        <group>
                            <field name="ggd_last_sent_recipient" readonly="1"/>
                            <field name="ggd_last_sent_subject" readonly="1"/>
                        </group>
                        <group>
                            <field name="ggd_last_sent_draft_version" readonly="1"/>
                            <field name="ggd_last_sent_body_summary" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kanban card: the Aurora card, one to one with the design. Title, a
         subtitle of city and industry, and one row that carries the fit score
         and the outbound state. Everything else Odoo puts on a CRM card -
         the partner avatar, the priority stars, the assignee, the rotting
         clock - is gone: the board is one person's outreach queue, the column
         order is set by hand, and the scheduled activity is the only one of
         them that says anything, so it moves into the pill row. -->
    <record id="crm_lead_view_kanban_ggd" model="ir.ui.view">
        <field name="name">crm.lead.kanban.ggd.controls</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <!-- Cards can be reordered by hand inside a column: the kanban
                 sorts by the sequence field first, then as the CRM does. -->
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">sequence, priority desc, id desc</attribute>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="before">
                <field name="sequence"/>
                <field name="city"/>
                <field name="ggd_board_state"/>
            </xpath>
            <!-- The line under the column title is the mix of outbound states
                 of the cards in the column, as the design draws it, and it
                 keeps Odoo's own behaviour: clicking a segment filters the
                 column down to that state. The revenue sums are dropped -
                 this pipeline is about people to write to, not money. -->
            <xpath expr="//progressbar" position="attributes">
                <attribute name="field">ggd_board_state</attribute>
                <attribute name="colors">{"ok": "success", "wait": "warning", "review": "info", "stop": "danger"}</attribute>
                <attribute name="sum_field"/>
                <attribute name="recurring_revenue_sum_field"/>
                <attribute name="help">Filter the column by outbound state: teal done, amber waiting on you, violet needs a decision, rose stop and look.</attribute>
            </xpath>
            <!-- Odoo's own card body goes first, so the subtitle below can
                 reuse partner_name without an xpath having to tell the two
                 apart. The partner block repeats the title on every record
                 this CRM creates, and the footer is three controls the design
                 has no place for: priority, because the column is ordered by
                 hand; the assignee, because there is one user; the rotting
                 clock, because the review desk already asks that question. -->
            <xpath expr="//t[@t-name='card']//div[hasclass('d-flex')][field[@name='partner_id']]" position="replace"/>
            <xpath expr="//field[@name='contact_name']" position="replace"/>
            <xpath expr="//field[@name='partner_name']" position="replace"/>
            <xpath expr="//t[@t-name='card']/footer" position="replace"/>
            <!-- The revenue line is hidden by the theme, not removed here: the
                 CRM's forecast kanban inherits this view and looks for the
                 expected_revenue field with an xpath of its own. -->
            <xpath expr="//t[@t-name='card']//div[hasclass('o_kanban_card_crm_lead_revenue')]" position="after">
                <div class="ggd_kanban_sub">
                    <field name="city" invisible="not city"/>
                    <span t-if="record.city.raw_value and record.ggd_industry.raw_value"> · </span>
                    <field name="ggd_industry" invisible="not ggd_industry"/>
                    <field name="partner_name" invisible="city or ggd_industry"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="replace">
                <div class="ggd_kanban_row">
                    <field name="ggd_fit_score" widget="ggd_ring" options="{'variant': 'bar'}"/>
                    <div class="ggd_kanban_pills">
                        <field name="ggd_draft_status" widget="badge"
                               invisible="not ggd_draft_status or ggd_draft_status == 'empty'"
                               decoration-success="ggd_draft_status in ('approved', 'sent')"
                               decoration-warning="ggd_draft_status == 'ready'"/>
                        <field name="ggd_delivery_status" widget="badge"
                               invisible="not ggd_delivery_status or ggd_delivery_status == 'none'"
                               decoration-danger="ggd_delivery_status in ('claimed', 'bounced')"
                               decoration-success="ggd_delivery_status == 'accepted'"/>
                        <field name="ggd_reply_category" widget="badge"
                               invisible="not ggd_reply_category"
                               decoration-success="ggd_reply_category in ('interested', 'meeting')"
                               decoration-info="ggd_reply_category in ('objection', 'unclear', 'information', 'referral')"
                               decoration-danger="ggd_reply_category in ('unsubscribe', 'not_interested')"/>
                        <field name="ggd_qualification_state" widget="badge"
                               invisible="ggd_qualification_state != 'review'"
                               decoration-info="ggd_qualification_state == 'review'"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="activity_ids" widget="kanban_activity"/>
                    </div>
                    <!-- The design lights the card that is waiting on a
                         person. The theme finds it with :has() on this
                         marker, so no card class has to be computed. -->
                    <span class="ggd_card_wait" invisible="ggd_board_state != 'wait'"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- The list is where the bulk actions are used, so the two things a
         bulk action changes are available as columns. Both are optional and
         hidden by default: the stock list is already wide, and a column
         nobody asked for is a column in the way. -->
    <record id="crm_lead_view_list_ggd_classification" model="ir.ui.view">
        <field name="name">crm.lead.list.ggd.classification</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="before">
                <field name="ggd_product_group_ids" string="Product groups"
                       optional="hide" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="ggd_company_type" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- The four filters behind the pipeline's quick-filter chips. They live
         in the search view rather than in the chip component because a chip
         has to leave a facet behind: a user who clicks "Needs review" and then
         opens the Filters menu must see the same filter ticked, and one who
         saves the view must get his chip back. The chip only toggles them.
         The domains are ggd_board_chip_counts()'s domains; keep the two in
         step or a chip will count one set and filter another. -->
    <record id="crm_lead_view_search_ggd_board" model="ir.ui.view">
        <field name="name">crm.lead.search.ggd.board</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[1]" position="before">
                <!-- The three dimensions the board is narrowed by. They are
                     search *fields*, not filters, because Odoo gives each
                     field its own facet group: several values inside one
                     field are ORed, and two different fields are ANDed. That
                     is exactly "Turkey or Poland, and Wire, and Manufacturer",
                     without a line of code. country_id is already in the
                     stock search view above; source_id and these two are not.

                     No group-by is offered on the product group. Grouping a
                     list by a many2many prints a lead once per group it is
                     in, and a lead in Wire and Pipe must be shown once and
                     counted once. -->
                <field name="ggd_product_group_ids" string="Product group"/>
                <field name="ggd_company_type"/>
                <field name="source_id" string="Lead source"/>
                <filter name="ggd_chip_sendable" string="Sendable today"
                        domain="[('ggd_outreach_approved','=',True),
                                 ('ggd_draft_status','=','approved'),
                                 ('ggd_do_not_contact','=',False),
                                 ('email_from','!=',False)]"/>
                <filter name="ggd_chip_needs_review" string="Needs review"
                        domain="['|','|','|','|',
                                 ('ggd_automation_needs_review','=',True),
                                 ('ggd_qualification_needs_review','=',True),
                                 ('ggd_reply_needs_review','=',True),
                                 ('ggd_delivery_needs_review','=',True),
                                 ('ggd_workflow_needs_review','=',True)]"/>
                <filter name="ggd_chip_unresolved_claim" string="Unresolved claim"
                        domain="[('ggd_delivery_status','=','claimed')]"/>
                <filter name="ggd_chip_replies" string="Replies"
                        domain="[('ggd_last_reply_received_at','!=',False)]"/>

                <separator/>

                <!-- Follow-up state. Derived, never stored a second time -
                     every one of the three is a question asked of records the
                     addon already keeps:

                       not contacted   Odoo has confirmed no send, and nobody
                                       has written in. A prepared draft is not
                                       contact, so it does not count here
                                       either.
                       awaiting reply  the same domain the review desk's
                                       "Sent, no reply yet" filter uses: the
                                       delivery was accepted and no reply has
                                       arrived.
                       follow-up due   Odoo's own activity state. The next
                                       scheduled activity is due today or is
                                       late.

                     The three are one group, so picking two asks for either. -->
                <filter name="ggd_follow_not_contacted" string="Not contacted"
                        domain="[('ggd_send_confirmed_at','=',False),
                                 ('ggd_last_reply_received_at','=',False)]"/>
                <filter name="ggd_follow_awaiting_reply" string="Awaiting a reply"
                        domain="[('ggd_delivery_status','=','accepted'),
                                 ('ggd_last_reply_received_at','=',False)]"/>
                <filter name="ggd_follow_up_due" string="Follow-up due or late"
                        domain="[('activity_state','in',['today','overdue'])]"/>

                <separator/>

                <!-- The gaps. Classification is never guessed from the
                     product-focus paragraph, so records simply arrive
                     unclassified and have to be findable. The third one is
                     the case that would otherwise hide: archiving a group
                     leaves it on every lead that carried it, so those leads
                     look classified and appear in no picker. -->
                <filter name="ggd_gap_country" string="Country missing"
                        domain="[('country_id','=',False)]"/>
                <filter name="ggd_gap_product_group" string="Product group missing"
                        domain="[('ggd_product_group_state','=','none')]"/>
                <filter name="ggd_gap_archived_group" string="Only archived product groups"
                        domain="[('ggd_product_group_state','=','archived')]"/>

                <separator/>
            </xpath>

            <!-- Group-by. Country and company type only, for the reason given
                 above the product-group field. -->
            <xpath expr="//search/group[1]" position="inside">
                <filter name="ggd_group_by_country" string="Country"
                        context="{'group_by': 'country_id'}"/>
                <filter name="ggd_group_by_company_type" string="Company type"
                        context="{'group_by': 'ggd_company_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
