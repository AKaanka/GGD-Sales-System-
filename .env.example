# Local addresses
ODOO_LOCAL_PORT=8069
N8N_LOCAL_PORT=5678
TIMEZONE=Europe/Berlin

# Odoo
ODOO_VERSION=19.0-20260810
ODOO_DB_NAME=ggd
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME_ODOO_DB_PASSWORD
ODOO_MASTER_PASSWORD=CHANGE_ME_ODOO_MASTER_PASSWORD

# n8n
N8N_VERSION=2.34.6
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_N8N_DB_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY

# Backup encryption and off-device copy (finding S6)
# BACKUP_AGE_RECIPIENT is the PUBLIC half of an age key pair and is not secret.
# Generate the pair once, on a machine you trust:
#     age-keygen -o ggd-backup.key
# The file holds the PRIVATE key: put it in the password manager and delete the
# local copy. Its first line comments the public key - that is the value below.
# Backups encrypt to it, so this machine writes a backup it cannot itself read.
BACKUP_AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_KEY
# Where the off-device copy goes: an external disk or a synced folder.
# backup.sh refuses to run without it, and refuses if the path is not mounted.
BACKUP_OFFSITE_DIR=CHANGE_ME_OFFSITE_PATH
