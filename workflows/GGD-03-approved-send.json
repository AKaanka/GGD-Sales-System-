{
  "name": "GGD-03 Approved reviewed draft send",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 15}]}},
      "id": "bdcdfafe-39a8-4bf9-92f2-833e02dc4d19",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-900, -80]
    },
    {
      "parameters": {},
      "id": "9317cd16-b0fc-446d-85c6-d36f89bdba07",
      "name": "Manual test trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-900, 80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://odoo:8069/json/2/crm.lead/search_read",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-Odoo-Database", "value": "ggd"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { domain: [['active','=',true],['ggd_outreach_approved','=',true],['ggd_do_not_contact','=',false],['ggd_contact_basis','!=',false],['ggd_draft_status','=','approved'],['ggd_approved_draft_version','!=',false],['email_from','!=',false]], fields: ['id','name','email_from','ggd_contact_basis','ggd_outreach_approved','ggd_do_not_contact','ggd_draft_subject','ggd_draft_body','ggd_draft_version','ggd_approved_draft_version','ggd_draft_status'], limit: 10, order: 'ggd_outreach_approved_at asc, id asc' } }}",
        "options": {}
      },
      "id": "162c979d-74b9-464c-8728-106330a36de1",
      "name": "Select approved reviewed drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [-650, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_WITH_ODOO_JSON2_CREDENTIAL", "name": "Odoo JSON-2 bearer token"}}
    },
    {
      "parameters": {"jsCode": "const incoming = $input.all().map(item => item.json);\nlet rows = incoming;\nif (incoming.length === 1) {\n  const first = incoming[0];\n  rows = Array.isArray(first) ? first : (Array.isArray(first.body) ? first.body : (first && first.id ? [first] : []));\n}\nreturn rows.map(row => ({ json: row }));"},
      "id": "7877b911-f2d8-48bc-a870-d014734aaf35",
      "name": "One candidate per item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-410, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\nconst required = lead.ggd_outreach_approved === true && lead.ggd_do_not_contact === false && Boolean(lead.ggd_contact_basis) && Boolean(lead.email_from) && Boolean(lead.ggd_draft_subject) && Boolean(lead.ggd_draft_body) && lead.ggd_draft_status === 'approved' && lead.ggd_draft_version === lead.ggd_approved_draft_version;\nif (!required) throw new Error(`Opportunity ${lead.id} failed the final reviewed-draft gate; nothing was sent.`);\nconst body = String(lead.ggd_draft_body).trim();\nreturn { json: { ...lead, send_key: `${lead.id}:${lead.ggd_approved_draft_version}`, body_summary: body.replace(/\\s+/g, ' ').slice(0, 500) } };"
      },
      "id": "79e4b5e2-69f4-4fde-a935-36c467475d61",
      "name": "Prepare exact reviewed send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-170, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [
            {
              "id": "413bc6b4-b9d7-4f26-9249-d352a98a7b12",
              "leftValue": "={{ $json.email_from }}",
              "rightValue": "REPLACE_WITH_KAAN_TEST_RECIPIENT",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5510a8df-5111-4b16-9005-1015381238be",
      "name": "Gate 4 recipient allowlist (temporary)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [70, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "throw new Error('Recipient is not on the Gate 4 test allowlist; nothing was sent.');"
      },
      "id": "6a3ef005-a935-47cd-b36f-f67c0011ba88",
      "name": "Reject recipient outside Gate 4 allowlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [310, 190]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://odoo:8069/json/2/crm.lead/ggd_claim_send_key",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-Odoo-Database", "value": "ggd"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { ids: [$json.id], send_key: $json.send_key } }}",
        "options": {}
      },
      "id": "e40ac194-4da8-4bb6-b9c4-d1e8a6b3f366",
      "name": "Claim send key before SMTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [310, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_WITH_ODOO_JSON2_CREDENTIAL", "name": "Odoo JSON-2 bearer token"}}
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json;\nconst claimed = raw === true || raw.body === true || raw.data === true || raw.result === true;\nif (!claimed) return null;\nreturn { json: $('Prepare exact reviewed send').item.json };"
      },
      "id": "817df7da-60da-421a-ad82-42e17122d765",
      "name": "Continue only for new claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [550, 0]
    },
    {
      "parameters": {
        "fromEmail": "REPLACE_WITH_KAAN_TEST_SENDER",
        "toEmail": "={{ $json.email_from }}",
        "subject": "={{ $json.ggd_draft_subject }}",
        "emailFormat": "text",
        "text": "={{ $json.ggd_draft_body }}",
        "options": {"appendAttribution": false}
      },
      "id": "d111e55a-a292-4090-bfcf-bb0a8a810091",
      "name": "Send exact reviewed draft via Zoho",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [790, 0],
      "credentials": {"smtp": {"id": "REPLACE_WITH_ZOHO_SMTP_CREDENTIAL", "name": "Zoho SMTP"}},
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const smtp = $json;\nconst prepared = $('Prepare exact reviewed send').item.json;\nconst messageId = smtp.messageId || smtp.messageID || smtp.response?.messageId || smtp.response?.messageID;\nif (!messageId) throw new Error(`SMTP reported success for opportunity ${prepared.id} but returned no Message-ID. Do not retry; inspect Zoho Sent and the claimed key.`);\nreturn { json: { ...prepared, smtp_message_id: String(messageId) } };"
      },
      "id": "3b4a94dd-130a-4297-a929-ab4f92c58fe2",
      "name": "Require SMTP Message-ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1030, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://odoo:8069/json/2/crm.lead/ggd_finalize_send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-Odoo-Database", "value": "ggd"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { ids: [$json.id], message_id: $json.smtp_message_id, recipient: $json.email_from, subject: $json.ggd_draft_subject, body_summary: $json.body_summary } }}",
        "options": {}
      },
      "id": "20338b39-1171-4120-84ea-5846126ea42b",
      "name": "Finalize complete send audit in Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1270, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_WITH_ODOO_JSON2_CREDENTIAL", "name": "Odoo JSON-2 bearer token"}},
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prepared = $('Prepare exact reviewed send').item.json;\nconst message = String($json.error?.message || $json.message || $json.description || 'SMTP or final audit failed').replace(/\\s+/g, ' ').slice(0, 350);\nreturn { json: { id: prepared.id, send_may_have_occurred: true, summary: `Workflow 3 stopped after claiming ${prepared.send_key}: ${message}. Check Zoho Sent and the Odoo send key before any retry.` } };"
      },
      "id": "92f202a8-37d7-4383-88e4-0ee9c3b6cdcb",
      "name": "Prepare uncertain-send review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 190]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://odoo:8069/json/2/crm.lead/ggd_record_automation_error",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-Odoo-Database", "value": "ggd"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { ids: [$json.id], summary: $json.summary, send_may_have_occurred: $json.send_may_have_occurred } }}",
        "options": {}
      },
      "id": "28871797-ce20-4e69-85c4-190107052f12",
      "name": "Record uncertain send for manual recovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1290, 190],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_WITH_ODOO_JSON2_CREDENTIAL", "name": "Odoo JSON-2 bearer token"}}
    },
    {
      "parameters": {
        "content": "## Setup before activation\n1. Attach the Odoo JSON-2 bearer credential to every Odoo request.\n2. Attach Zoho SMTP and replace the sender placeholder.\n3. Set the shared GGD error workflow in workflow settings.\n4. Test only with a Kaan-owned recipient.\n\nThis workflow sends only the exact draft/version approved in Odoo. It never drafts after approval.",
        "height": 300,
        "width": 430
      },
      "id": "0a3b1f95-df62-4eef-a6a0-676707a50a71",
      "name": "Activation checklist",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-910, -430]
    }
  ],
  "connections": {
